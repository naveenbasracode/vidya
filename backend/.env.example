# Copy this file to .env and adjust the values.
# On a Mac with Homebrew PostgreSQL the default user is your macOS username with no password:
#   DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/vidya_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vidya_db
# Separate database used by `npm run test:api` (wiped on every run)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vidya_test
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# Where uploaded curriculum PDFs are stored (relative to backend/)
UPLOAD_DIR=uploads
